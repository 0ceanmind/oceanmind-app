# OceanMind environment — copy to .env for local Postgres, or set these in Vercel.
# Leave DATABASE_URL unset locally to use the built-in SQLite file instead.

# Supabase Postgres connection string (use the CONNECTION POOLER, port 6543).
# Supabase dashboard → Project Settings → Database → Connection string → "Transaction pooler".
# Example: postgresql://postgres.mfyrwjkhlmcaebsmxtzf:YOUR-DB-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# LLM provider key (server-side only, never exposed to the browser).
DEEPSEEK_API_KEY=
# Optional overrides:
# OCEANMIND_AI_MODEL=deepseek-v4-flash
# OCEANMIND_AI_PROVIDER=deepseek

# Stable secret for signing session cookies (any long random string).
COOKIE_SECRET=
